<mvc:View
  controllerName="com.sap.demo.managespec.controller.Detail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:form="sap.ui.layout.form"
  xmlns:uxap="sap.uxap"
  xmlns:ui="sap.ui.table"
  displayBlock="true">

  <Page showHeader="false" enableScrolling="false" class="detailPage">
    <content>
      <f:DynamicPage id="detailPage" toggleHeaderOnTitleClick="true" showFooter="false" stickySubheaderProvider="detailTabBar">

        <f:title>
          <f:DynamicPageTitle class="sapUiSizeCompact">
            <f:heading>
              <VBox>
                <Title text="{detail>/name}" level="H2" />
                <Text text="{detail>/technicalName}" class="detailSpecSubtitle" />
              </VBox>
            </f:heading>
            <f:snappedHeading>
              <VBox>
                <Title text="{detail>/name}" level="H3" />
                <Text text="{detail>/technicalName}" class="detailSpecSubtitle" />
              </VBox>
            </f:snappedHeading>
            <f:actions>
              <Button text="Delete" type="Ghost" />
              <Button text="Copy" type="Ghost" />
              <Button text="Change Product Category" type="Ghost" />
              <Button text="Transfer Data" type="Ghost" />
              <MenuButton text="Next Steps" type="Ghost" buttonMode="Regular" menuPosition="BeginBottom">
                <menu>
                  <Menu>
                    <items>
                      <MenuItem text="Submit for Review" />
                      <MenuItem text="Release" />
                      <MenuItem text="Block" />
                    </items>
                  </Menu>
                </menu>
              </MenuButton>
              <Button text="New Version" type="Ghost" />
              <Button icon="sap-icon://action" type="Transparent" />
            </f:actions>
          </f:DynamicPageTitle>
        </f:title>

        <f:header>
          <f:DynamicPageHeader pinnable="true">
            <HBox alignItems="Start" class="sapUiMediumMarginBottom">
              <Avatar src="sap-icon://product" displayShape="Square" class="detailHeaderAvatar sapUiMediumMarginEnd" />
              <VBox class="sapUiMediumMarginEnd detailHeaderCol">
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                  <Label text="Version:" class="detailAttrLabel sapUiTinyMarginEnd" />
                  <Text text="{detail>/version}" />
                </HBox>
                <HBox alignItems="Center">
                  <Label text="Status:" class="detailAttrLabel sapUiTinyMarginEnd" />
                  <ObjectStatus text="{detail>/statusText}" state="{detail>/statusState}" icon="{detail>/statusIcon}" />
                </HBox>
              </VBox>
              <VBox class="detailHeaderCol">
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                  <Label text="Specification Type:" class="detailAttrLabel sapUiTinyMarginEnd" />
                  <Text text="{detail>/specType}" />
                </HBox>
                <HBox alignItems="Center">
                  <Label text="Product Category:" class="detailAttrLabel sapUiTinyMarginEnd" />
                  <Text text="{detail>/productCategory}" />
                </HBox>
              </VBox>
            </HBox>
          </f:DynamicPageHeader>
        </f:header>

        <f:content>
          <IconTabBar id="detailTabBar" class="detailTabBar sapUiNoContentPadding" expanded="true" select=".onTabSelect">
            <items>

              <!-- General Tab -->
              <IconTabFilter text="General" key="general">
                <uxap:ObjectPageLayout
                  id="generalObjectPage"
                  useIconTabBar="false"
                  upperCaseAnchorBar="false"
                  showTitleInHeaderContent="false"
                  alwaysShowContentHeader="false"
                  preserveHeaderStateOnScroll="false"
                  showAnchorBar="false"
                  showHeaderContent="false"
                  enableLazyLoading="false"
                  class="detailGeneralPage">
                  <uxap:sections>

                    <uxap:ObjectPageSection title=" " titleUppercase="false">
                      <uxap:subSections>
                        <uxap:ObjectPageSubSection title=" ">
                          <uxap:blocks>
                            <VBox width="100%">
                              <Toolbar class="sapUiSizeCompact detailSectionToolbar detailPlainToolbar">
                                <Title text="Basic Data" level="H4" />
                              </Toolbar>
                              <form:SimpleForm
                                layout="ColumnLayout"
                                columnsM="2" columnsL="4" columnsXL="4"
                                class="sapUxAPObjectPageSubSectionAlignContent">
                                <Label text="ID" />
                                <Text text="{detail>/id}" />
                                <Label text="Status" />
                                <ObjectStatus text="{detail>/statusText}" state="{detail>/statusState}" />
                                <Label text="Name" />
                                <Text text="{detail>/name}" />
                                <Label text="Product Category" />
                                <Text text="{detail>/productCategory}" />
                                <Label text="Version" />
                                <Text text="{detail>/version}" />
                                <Label text="Specification Type" />
                                <Text text="{detail>/specType}" />
                              </form:SimpleForm>
                            </VBox>
                          </uxap:blocks>
                        </uxap:ObjectPageSubSection>
                      </uxap:subSections>
                    </uxap:ObjectPageSection>

                    <uxap:ObjectPageSection title=" " titleUppercase="false">
                      <uxap:subSections>
                        <uxap:ObjectPageSubSection title=" ">
                          <uxap:blocks>
                            <VBox width="100%">
                              <Toolbar class="sapUiSizeCompact detailSectionToolbar">
                                <Title text="Other Versions" level="H4" />
                                <ToolbarSpacer />
                                <SearchField placeholder="Search" width="14rem" />
                                <Button icon="sap-icon://action-settings" type="Transparent" />
                                <Button icon="sap-icon://slim-arrow-down" type="Transparent" />
                              </Toolbar>
                              <Table items="{detail>/otherVersions}" class="sapUiSizeCompact detailTable">
                                <columns>
                                  <Column><Text text="Name" /></Column>
                                  <Column width="8rem"><Text text="Version" /></Column>
                                  <Column><Text text="Status" /></Column>
                                </columns>
                                <items>
                                  <ColumnListItem>
                                    <cells>
                                      <Text text="{name}" />
                                      <Text text="{version}" />
                                      <ObjectStatus text="{statusText}" state="{statusState}" />
                                    </cells>
                                  </ColumnListItem>
                                </items>
                                <noData>
                                  <IllustratedMessage illustrationType="sapIllus-NoData" illustrationSize="Dot"
                                    title="No items available" description="When there are, you'll find them here." />
                                </noData>
                              </Table>
                            </VBox>
                          </uxap:blocks>
                        </uxap:ObjectPageSubSection>
                      </uxap:subSections>
                    </uxap:ObjectPageSection>

                  </uxap:sections>
                </uxap:ObjectPageLayout>
              </IconTabFilter>

              <!-- Properties Tab -->
              <IconTabFilter text="Properties" key="properties">
                <VBox class="detailTabContent">
                  <VBox>
                    <Toolbar class="sapUiSizeCompact detailSectionToolbar">
                      <Title text="Properties" level="H4" />
                      <ToolbarSpacer />
                      <SearchField placeholder="Search" width="14rem" />
                      <Button icon="sap-icon://action-settings" type="Transparent" />
                      <Button icon="sap-icon://slim-arrow-down" type="Transparent" />
                    </Toolbar>
                    <Table items="{detail>/properties}" class="sapUiSizeCompact detailTable">
                      <columns>
                        <Column><Text text="Name" /></Column>
                        <Column><Text text="Value" /></Column>
                        <Column><Text text="Unit" /></Column>
                      </columns>
                      <items>
                        <ColumnListItem>
                          <cells>
                            <Text text="{name}" />
                            <Text text="{value}" />
                            <Text text="{unit}" />
                          </cells>
                        </ColumnListItem>
                      </items>
                      <noData>
                        <IllustratedMessage illustrationType="sapIllus-NoData" illustrationSize="Dot"
                          title="No items available" description="When there are, you'll find them here." />
                      </noData>
                    </Table>
                  </VBox>
                </VBox>
              </IconTabFilter>

              <!-- Related Objects Tab -->
              <IconTabFilter text="Related Objects" key="relatedObjects">
                <VBox class="detailTabContent">
                  <VBox>
                    <Toolbar class="sapUiSizeCompact detailSectionToolbar">
                      <Title text="Collaborations" level="H4" />
                      <ToolbarSpacer />
                      <SearchField placeholder="Search" width="14rem" />
                      <Button icon="sap-icon://action-settings" type="Transparent" />
                      <Button icon="sap-icon://slim-arrow-down" type="Transparent" />
                    </Toolbar>
                    <Table items="{detail>/collaborations}" class="sapUiSizeCompact detailTable">
                      <columns>
                        <Column><Text text="Name" /></Column>
                        <Column><Text text="Description" /></Column>
                        <Column width="10rem"><Text text="Created On" /></Column>
                        <Column><Text text="Created By" /></Column>
                      </columns>
                      <items>
                        <ColumnListItem>
                          <cells>
                            <Text text="{name}" />
                            <Text text="{description}" />
                            <Text text="{createdOn}" />
                            <Text text="{createdBy}" />
                          </cells>
                        </ColumnListItem>
                      </items>
                      <noData>
                        <IllustratedMessage illustrationType="sapIllus-NoData" illustrationSize="Dot"
                          title="No items available" description="When there are, you'll find them here." />
                      </noData>
                    </Table>
                  </VBox>
                </VBox>
              </IconTabFilter>

              <!-- Documents Tab -->
              <IconTabFilter text="Documents" key="documents">
                <VBox class="detailTabContent">
                  <Toolbar class="sapUiSizeCompact detailSectionToolbar">
                    <Title text="Items ({= ${detail>/documents}.length})" level="H4" />
                    <ToolbarSpacer />
                    <SearchField placeholder="Search" width="16rem" />
                    <Button icon="sap-icon://filter" type="Transparent" />
                    <MenuButton text="Link" type="Transparent" buttonMode="Regular" menuPosition="BeginBottom">
                      <menu>
                        <Menu>
                          <items>
                            <MenuItem text="Link Existing Document" press=".onLinkExistingDocument" />
                            <MenuItem text="Link New Document" />
                          </items>
                        </Menu>
                      </menu>
                    </MenuButton>
                    <Button id="unlinkBtn" text="Unlink Document" type="Transparent" enabled="false" press=".onUnlinkDocument" />
                    <Button icon="sap-icon://action-settings" type="Transparent" />
                  </Toolbar>
                  <ui:TreeTable
                    id="documentsTreeTable"
                    rows="{path: 'detail>/documents', parameters: {arrayNames: ['children']}}"
                    selectionMode="MultiToggle"
                    visibleRowCountMode="Fixed"
                    visibleRowCount="4"
                    rowSelectionChange=".onDocSelectionChange"
                    toggleOpenState=".onDocTreeToggle"
                    class="sapUiSizeCompact">
                    <ui:columns>
                      <ui:Column width="20rem">
                        <Label text="Document Info" />
                        <ui:template>
                          <Text text="{= ${detail>isParent} === true ? ${detail>docNumber} : ${detail>description} }"
                            class="{= ${detail>isParent} === true ? 'detailDocNumber' : '' }" />
                        </ui:template>
                      </ui:Column>
                      <ui:Column>
                        <Label text="Description" />
                        <ui:template>
                          <Text text="{detail>docDescription}" />
                        </ui:template>
                      </ui:Column>
                      <ui:Column width="8rem">
                        <Label text="Type" />
                        <ui:template>
                          <Text text="{detail>type}" />
                        </ui:template>
                      </ui:Column>
                      <ui:Column width="8rem">
                        <Label text="Part" />
                        <ui:template>
                          <Text text="{= ${detail>isParent} === true ? ${detail>part} : '' }" />
                        </ui:template>
                      </ui:Column>
                      <ui:Column width="8rem">
                        <Label text="Version" />
                        <ui:template>
                          <Text text="{= ${detail>isParent} === true ? ${detail>version} : '' }" />
                        </ui:template>
                      </ui:Column>
                      <ui:Column width="4rem" hAlign="End">
                        <Label text="" />
                        <ui:template>
                          <Button icon="sap-icon://navigation-right-arrow" type="Transparent" press=".onDocumentNavigate" />
                        </ui:template>
                      </ui:Column>
                    </ui:columns>
                  </ui:TreeTable>
                </VBox>
              </IconTabFilter>

              <!-- Documents 1 Tab (method 3: Modified On + Created By as second line in Description) -->
              <IconTabFilter text="Documents 1" key="documents1">
                <VBox class="detailTabContent">
                  <Toolbar class="sapUiSizeCompact detailSectionToolbar">
                    <Title text="Items ({= ${detail>/documents}.length})" level="H4" />
                    <ToolbarSpacer />
                    <SearchField placeholder="Search" width="16rem" />
                    <Button icon="sap-icon://filter" type="Transparent" />
                    <MenuButton text="Link" type="Transparent" buttonMode="Regular" menuPosition="BeginBottom">
                      <menu>
                        <Menu>
                          <items>
                            <MenuItem text="Link Existing Document" press=".onLinkExistingDocument" />
                            <MenuItem text="Link New Document" />
                          </items>
                        </Menu>
                      </menu>
                    </MenuButton>
                    <Button id="unlinkBtn1" text="Unlink Document" type="Transparent" enabled="false" press=".onUnlinkDocument" />
                    <Button icon="sap-icon://action-settings" type="Transparent" />
                  </Toolbar>
                  <ui:TreeTable
                    id="documentsTreeTable1"
                    rows="{path: 'detail>/documents', parameters: {arrayNames: ['children']}}"
                    selectionMode="MultiToggle"
                    visibleRowCountMode="Fixed"
                    visibleRowCount="4"
                    rowSelectionChange=".onDocSelectionChange1"
                    toggleOpenState=".onDocTreeToggle1"
                    class="sapUiSizeCompact detailTreeTable1">
                    <ui:columns>
                      <ui:Column width="20rem">
                        <Label text="Document Info" />
                        <ui:template>
                          <Text text="{= ${detail>isParent} === true ? ${detail>docNumber} : ${detail>description} }"
                            class="{= ${detail>isParent} === true ? 'detailDocNumber' : '' }" />
                        </ui:template>
                      </ui:Column>
                      <ui:Column>
                        <Label text="Description" />
                        <ui:template>
                          <Text text="{= ${detail>isParent} === true ? ${detail>docDescription} : (${detail>modifiedOn} ? ('Last modified on ' + ${detail>modifiedOn} + ' by ' + ${detail>createdBy}) : '') }"
                            class="{= ${detail>isParent} === true ? '' : 'detailDocMeta' }" />
                        </ui:template>
                      </ui:Column>
                      <ui:Column width="8rem">
                        <Label text="Type" />
                        <ui:template>
                          <Text text="{detail>type}" />
                        </ui:template>
                      </ui:Column>
                      <ui:Column width="8rem">
                        <Label text="Part" />
                        <ui:template>
                          <Text text="{= ${detail>isParent} === true ? ${detail>part} : '' }" />
                        </ui:template>
                      </ui:Column>
                      <ui:Column width="8rem">
                        <Label text="Version" />
                        <ui:template>
                          <Text text="{= ${detail>isParent} === true ? ${detail>version} : '' }" />
                        </ui:template>
                      </ui:Column>
                      <ui:Column width="4rem" hAlign="End">
                        <Label text="" />
                        <ui:template>
                          <Button icon="sap-icon://navigation-right-arrow" type="Transparent" press=".onDocumentNavigate" />
                        </ui:template>
                      </ui:Column>
                    </ui:columns>
                  </ui:TreeTable>
                </VBox>
              </IconTabFilter>

              <!-- Documents 2 Tab: Description merged into Document Info column as grey second line -->
              <IconTabFilter text="Documents 2" key="documents2">
                <VBox class="detailTabContent">
                  <Toolbar class="sapUiSizeCompact detailSectionToolbar">
                    <Title text="Items ({= ${detail>/documents}.length})" level="H4" />
                    <ToolbarSpacer />
                    <SearchField placeholder="Search" width="16rem" />
                    <Button icon="sap-icon://filter" type="Transparent" />
                    <MenuButton text="Link" type="Transparent" buttonMode="Regular" menuPosition="BeginBottom">
                      <menu>
                        <Menu>
                          <items>
                            <MenuItem text="Link Existing Document" press=".onLinkExistingDocument" />
                            <MenuItem text="Link New Document" />
                          </items>
                        </Menu>
                      </menu>
                    </MenuButton>
                    <Button id="unlinkBtn2" text="Unlink Document" type="Transparent" enabled="false" press=".onUnlinkDocument" />
                    <Button icon="sap-icon://action-settings" type="Transparent" />
                  </Toolbar>
                  <ui:TreeTable
                    id="documentsTreeTable2"
                    rows="{path: 'detail>/documents', parameters: {arrayNames: ['children']}}"
                    selectionMode="MultiToggle"
                    visibleRowCountMode="Fixed"
                    visibleRowCount="4"
                    columnHeaderHeight="32"
                    rowHeight="56"
                    rowSelectionChange=".onDocSelectionChange2"
                    toggleOpenState=".onDocTreeToggle2"
                    class="sapUiSizeCompact detailTreeTable2">
                    <ui:columns>
                      <ui:Column width="28rem">
                        <Label text="Document Info" />
                        <ui:template>
                          <VBox class="detailDocInfoCell">
                            <Text text="{= ${detail>isParent} === true ? ${detail>docNumber} : ${detail>description} }"
                              class="{= ${detail>isParent} === true ? 'detailDocNumber' : '' }" />
                            <Text text="{= ${detail>isParent} === true ? ${detail>docDescription} : (${detail>modifiedOn} ? ('Last modified on ' + ${detail>modifiedOn} + ' by ' + ${detail>createdBy}) : '') }"
                              class="detailDocMeta" />
                          </VBox>
                        </ui:template>
                      </ui:Column>
                      <ui:Column width="8rem">
                        <Label text="Type" />
                        <ui:template>
                          <Text text="{detail>type}" />
                        </ui:template>
                      </ui:Column>
                      <ui:Column width="8rem">
                        <Label text="Part" />
                        <ui:template>
                          <Text text="{= ${detail>isParent} === true ? ${detail>part} : '' }" />
                        </ui:template>
                      </ui:Column>
                      <ui:Column width="8rem">
                        <Label text="Version" />
                        <ui:template>
                          <Text text="{= ${detail>isParent} === true ? ${detail>version} : '' }" />
                        </ui:template>
                      </ui:Column>
                      <ui:Column width="4rem" hAlign="End">
                        <Label text="" />
                        <ui:template>
                          <Button icon="sap-icon://navigation-right-arrow" type="Transparent" press=".onDocumentNavigate" />
                        </ui:template>
                      </ui:Column>
                    </ui:columns>
                  </ui:TreeTable>
                </VBox>
              </IconTabFilter>

            </items>
          </IconTabBar>
        </f:content>

      </f:DynamicPage>
    </content>
  </Page>

</mvc:View>
