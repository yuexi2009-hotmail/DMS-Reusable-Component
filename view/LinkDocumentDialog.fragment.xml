<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog
    id="linkDocumentDialog"
    title="Search document"
    contentWidth="72rem"
    contentHeight="42rem"
    resizable="true"
    draggable="true"
    class="sapUiSizeCompact">

    <content>
      <VBox fitContainer="true">

        <!-- Tabs -->
        <IconTabBar
          id="linkDocDialogTabs"
          stretchContentHeight="false"
          backgroundDesign="Transparent"
          class="sapUiNoContentPadding linkDocTabBar">
          <items>
            <IconTabFilter text="Search and Select" key="search">
              <VBox>

                <!-- Search toolbar -->
                <Toolbar id="linkDocSearchToolbar" class="sapUiSizeCompact sapMTBTransparent linkDocSearchBar">
                  <SearchField
                    id="linkDocSearchField"
                    placeholder="Search"
                    search=".onLinkDocSearch" />
                  <ToolbarSpacer />
                  <Button text="Go" type="Emphasized" press=".onLinkDocSearch" />
                  <Button text="Show Filters" type="Transparent" press=".onLinkDocShowFilters" />
                </Toolbar>

                <!-- Results table -->
                <Table
                  id="linkDocResultTable"
                  items="{linkDoc>/documents}"
                  mode="MultiSelect"
                  sticky="ColumnHeaders,HeaderToolbar"
                  growing="true"
                  growingThreshold="20"
                  class="sapUiSizeCompact">
                  <headerToolbar>
                    <Toolbar class="sapUiSizeCompact sapMTBTransparent">
                      <Title text="Items ({= ${linkDoc>/documents}.length})" level="H5" />
                      <ToolbarSpacer />
                      <Button icon="sap-icon://copy" type="Transparent" />
                    </Toolbar>
                  </headerToolbar>
                  <columns>
                    <Column width="16rem"><Text text="Attachment" /></Column>
                    <Column width="14rem"><Text text="Document" /></Column>
                    <Column width="10rem"><Text text="Document No." /></Column>
                    <Column width="8rem"><Text text="Document Type" /></Column>
                    <Column width="7rem"><Text text="Document Part" /></Column>
                    <Column width="7rem"><Text text="Document Version" /></Column>
                    <Column width="8rem"><Text text="Document Status" /></Column>
                  </columns>
                  <items>
                    <ColumnListItem>
                      <cells>
                        <HBox alignItems="Center">
                          <core:Icon src="{linkDoc>fileIcon}" color="var(--sapContent_LabelColor)" useIconTooltip="false" class="sapUiTinyMarginEnd" />
                          <Text text="{linkDoc>fileName}" wrapping="false" />
                        </HBox>
                        <Text text="{linkDoc>docName}" wrapping="false" />
                        <Text text="{linkDoc>docNumber}" wrapping="false" />
                        <Text text="{linkDoc>type}" wrapping="false" />
                        <Text text="{linkDoc>part}" wrapping="false" />
                        <Text text="{linkDoc>version}" wrapping="false" />
                        <Text text="{linkDoc>status}" wrapping="false" />
                      </cells>
                    </ColumnListItem>
                  </items>
                </Table>

              </VBox>
            </IconTabFilter>

            <IconTabFilter text="Define Conditions" key="conditions">
              <VBox class="sapUiMediumMarginBeginEnd sapUiSmallMarginTop">
                <Text text="Define search conditions here." />
              </VBox>
            </IconTabFilter>
          </items>
        </IconTabBar>

      </VBox>
    </content>

    <beginButton>
      <Button text="Select" type="Emphasized" press=".onLinkDocConfirm" class="sapUiSizeCompact" width="auto" />
    </beginButton>
    <endButton>
      <Button text="Cancel" press=".onLinkDocCancel" class="sapUiSizeCompact" width="auto" />
    </endButton>

  </Dialog>

</core:FragmentDefinition>
