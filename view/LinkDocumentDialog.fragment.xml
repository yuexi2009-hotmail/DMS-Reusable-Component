<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog
    id="linkDocumentDialog"
    title="Search document"
    contentWidth="62rem"
    contentHeight="42rem"
    resizable="true"
    draggable="true"
    class="sapUiSizeCompact">

    <content>
      <VBox fitContainer="true">

        <!-- Tabs -->
        <IconTabBar
          id="linkDocDialogTabs"
          stretchContentHeight="false"
          backgroundDesign="Transparent"
          class="sapUiNoContentPadding linkDocTabBar">
          <items>
            <IconTabFilter text="Search and Select" key="search">
              <VBox class="sapUiMediumMarginBeginEnd sapUiSmallMarginTop sapUiSmallMarginBottom">

                <!-- Search row: field stretches, Go + Show Filters pinned right -->
                <Toolbar id="linkDocSearchToolbar" class="sapUiSizeCompact sapMTBTransparent linkDocSearchBar">
                  <SearchField
                    id="linkDocSearchField"
                    placeholder="Search"
                    search=".onLinkDocSearch" />
                  <ToolbarSpacer />
                  <Button text="Go" type="Emphasized" press=".onLinkDocSearch" />
                  <Button text="Show Filters" type="Transparent" press=".onLinkDocShowFilters" />
                </Toolbar>
                <VBox height="1rem" />

                <!-- Results table with headerToolbar: title left, icon right -->
                <ui:TreeTable
                  xmlns:ui="sap.ui.table"
                  id="linkDocResultTable"
                  rows="{path: 'linkDoc>/documents', parameters: {arrayNames: ['children']}}"
                  selectionMode="MultiToggle"
                  visibleRowCountMode="Fixed"
                  visibleRowCount="9"
                  rowHeight="48"
                  columnHeaderHeight="32"
                  rowSelectionChange=".onLinkDocSelectionChange"
                  toggleOpenState=".onLinkDocTreeToggle"
                  class="sapUiSizeCompact detailTreeTable1">
                  <ui:extension>
                    <Toolbar class="sapUiSizeCompact sapMTBTransparent">
                      <Title text="Items ({= ${linkDoc>/documents}.length})" level="H5" />
                      <ToolbarSpacer />
                      <Button icon="sap-icon://copy" type="Transparent" />
                    </Toolbar>
                  </ui:extension>
                  <ui:columns>
                    <ui:Column width="20rem">
                      <Label text="Document Info" />
                      <ui:template>
                        <FormattedText htmlText="{= ${linkDoc>isParent} === true ? ('&lt;strong&gt;' + ${linkDoc>docNumber} + '&lt;/strong&gt;') : ${linkDoc>description} }" />
                      </ui:template>
                    </ui:Column>
                    <ui:Column>
                      <Label text="Description" />
                      <ui:template>
                        <Text text="{= ${linkDoc>isParent} === true ? ${linkDoc>docDescription} : (${linkDoc>modifiedOn} ? ('Last modified on ' + ${linkDoc>modifiedOn} + ' by ' + ${linkDoc>createdBy}) : '') }"
                          class="{= ${linkDoc>isParent} === true ? '' : 'detailDocMeta' }" />
                      </ui:template>
                    </ui:Column>
                    <ui:Column width="8rem">
                      <Label text="Type" />
                      <ui:template>
                        <Text text="{linkDoc>type}" />
                      </ui:template>
                    </ui:Column>
                    <ui:Column width="8rem">
                      <Label text="Part" />
                      <ui:template>
                        <Text text="{= ${linkDoc>isParent} === true ? ${linkDoc>part} : '' }" />
                      </ui:template>
                    </ui:Column>
                    <ui:Column width="8rem">
                      <Label text="Version" />
                      <ui:template>
                        <Text text="{= ${linkDoc>isParent} === true ? ${linkDoc>version} : '' }" />
                      </ui:template>
                    </ui:Column>
                  </ui:columns>
                </ui:TreeTable>

              </VBox>
            </IconTabFilter>

            <IconTabFilter text="Define Conditions" key="conditions">
              <VBox class="sapUiMediumMarginBeginEnd sapUiSmallMarginTop">
                <Text text="Define search conditions here." />
              </VBox>
            </IconTabFilter>
          </items>
        </IconTabBar>

      </VBox>
    </content>

    <beginButton>
      <Button text="OK" type="Emphasized" press=".onLinkDocConfirm" class="sapUiSizeCompact" width="auto" />
    </beginButton>
    <endButton>
      <Button text="Cancel" press=".onLinkDocCancel" class="sapUiSizeCompact" width="auto" />
    </endButton>

  </Dialog>

</core:FragmentDefinition>
