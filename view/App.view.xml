<mvc:View
    controllerName="com.sap.demo.managespec.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.f"
    xmlns:m="sap.m"
    displayBlock="true"
    class="manageSpecApp">

    <ShellBar
        id="appShellBar"
        title="Manage Specifications"
        showNavButton="true"
        showNotifications="true"
        showProductSwitcher="false"
        navButtonPressed=".onNavBack"
        homeIcon="./images/logo_sap.png"
        homeIconPressed=".onHomePressed">
        <additionalContent>
            <m:OverflowToolbarButton icon="sap-icon://headset" type="Transparent" />
            <m:OverflowToolbarButton icon="sap-icon://contacts" type="Transparent" />
            <m:OverflowToolbarButton icon="sap-icon://tag" type="Transparent" />
        </additionalContent>
        <menu>
            <m:Menu>
                <m:MenuItem text="Manage Specifications" icon="sap-icon://document"/>
            </m:Menu>
        </menu>
        <profile>
            <m:Avatar
                id="userAvatar"
                initials="yx"
                displaySize="XS"
                press=".onAvatarPress"/>
        </profile>
        <searchManager>
            <SearchManager id="searchManager" placeholder="Search..."/>
        </searchManager>
    </ShellBar>

    <m:App id="app" class="manageSpecFCL"/>

</mvc:View>
