<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  displayBlock="true"
  controllerName="com.sap.demo.managespec.controller.App">

  <f:ShellBar
    id="appShellBar"
    title="Manage Specifications"
    homeIcon="images/logo_sap.png"
    homeIconTooltip="SAP"
    showNavButton="true"
    showSearch="true"
    showNotifications="true"
    showProductSwitcher="false"
    showMenuButton="false"
    navButtonPressed=".onNavBack">
    <f:additionalContent>
      <OverflowToolbarButton icon="sap-icon://headset" type="Transparent" />
      <OverflowToolbarButton icon="sap-icon://contacts" type="Transparent" />
      <OverflowToolbarButton icon="sap-icon://tag" type="Transparent" />
    </f:additionalContent>
    <f:profile>
      <Avatar initials="yx" displayShape="Circle" />
    </f:profile>
  </f:ShellBar>

  <App id="app" class="manageSpecApp" />

</mvc:View>
