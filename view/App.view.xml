<mvc:View
    controllerName="com.sap.demo.managespec.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.f"
    xmlns:m="sap.m"
    displayBlock="true"
    class="manageSpecApp">

    <ShellBar
        id="appShellBar"
        title="Document Management"
        showNavButton="true"
        showNotifications="true"
        showProductSwitcher="false"
        navButtonPressed=".onNavBack"
        homeIcon="./images/logo_sap.png"
        homeIconPressed=".onHomePressed">
        <additionalContent>
            <m:OverflowToolbarButton icon="sap-icon://headset" type="Transparent" />
            <m:OverflowToolbarButton icon="sap-icon://contacts" type="Transparent" />
            <m:OverflowToolbarButton icon="sap-icon://tag" type="Transparent" />
        </additionalContent>
        <menu>
            <m:Menu>
                <m:MenuItem text="Document Management" icon="sap-icon://document"/>
            </m:Menu>
        </menu>
        <profile>
            <m:Avatar
                id="userAvatar"
                initials="yx"
                displaySize="XS"
                press=".onAvatarPress"/>
        </profile>
        <searchManager>
            <SearchManager id="searchManager" placeholder="Search..."/>
        </searchManager>
    </ShellBar>

    <FlexibleColumnLayout
        id="appFCL"
        layout="{appView>/fclLayout}"
        class="manageSpecFCL">
        <beginColumnPages>
            <m:App id="app" />
        </beginColumnPages>
        <midColumnPages>
            <mvc:XMLView
                id="doc4DetailView"
                viewName="com.sap.demo.managespec.view.Doc4Detail" />
        </midColumnPages>
    </FlexibleColumnLayout>

</mvc:View>
