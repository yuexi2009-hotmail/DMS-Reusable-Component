{
  "_version": "2.0.0",
  "sap.app": {
    "id": "com.sap.demo.dmscreate",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [""],
      "fallbackLocale": ""
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": { "version": "1.0.0" }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": false }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "com.sap.demo.dmscreate.view.App",
      "type": "XML",
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.f": {},
        "sap.uxap": {},
        "sap.ui.layout": {}
      }
    },
    "handleValidation": true,
    "contentDensities": { "compact": true, "cozy": true },
    "resources": {
      "css": [{ "uri": "css/style.css" }]
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.sap.demo.dmscreate.i18n.i18n",
          "supportedLocales": [""],
          "fallbackLocale": "",
          "async": true
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "type": "View",
        "viewType": "XML",
        "path": "com.sap.demo.dmscreate.view",
        "controlId": "app",
        "controlAggregation": "pages"
      },
      "routes": [
        { "pattern": "", "name": "dmsCreate", "target": "dmsCreate" }
      ],
      "targets": {
        "dmsCreate": { "id": "dmsCreate", "name": "DmsCreate" }
      }
    }
  }
}
