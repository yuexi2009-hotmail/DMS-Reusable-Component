<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:l="sap.ui.layout"
  xmlns:mdc="sap.ui.mdc"
  xmlns:mdct="sap.ui.mdc.table">

  <Dialog
    id="linkDocumentDialog"
    title="Link Documents"
    contentWidth="80rem"
    contentHeight="44rem"
    resizable="true"
    draggable="true"
    class="sapUiSizeCompact linkDocumentDialog">

    <content>
      <VBox fitContainer="true">

        <!-- Search bar -->
        <Toolbar class="sapUiSizeCompact sapMTBTransparent linkDocSearchBar">
          <SearchField
            id="linkDocSearchField"
            placeholder="Search"
            width="30rem"
            search=".onLinkDocSearch" />
          <ToolbarSpacer />
          <Button id="linkDocGoBtn" text="Go" type="Emphasized" press=".onLinkDocGo" />
          <Button id="linkDocToggleFiltersBtn" text="Hide Filters" type="Transparent" press=".onLinkDocToggleFilters" style="margin-left:0.5rem" />
        </Toolbar>

        <!-- Filter bar -->
        <VBox id="linkDocFilterBar" visible="true" class="sapUiSmallMarginBottom">
          <HBox wrap="Wrap" class="sapUiSmallMarginTop">
            <VBox class="sapUiSmallMarginEnd" width="14rem">
              <Label text="Document Type:" />
              <Select id="linkDocTypeFilter" width="100%" change=".onLinkDocFilterChange">
                <core:Item key="" text="All" />
                <core:Item key="DFT" text="DFT" />
                <core:Item key="DRW" text="DRW" />
                <core:Item key="TST" text="TST" />
                <core:Item key="IMU" text="IMU" />
              </Select>
            </VBox>
            <VBox width="14rem">
              <Label text="Status:" />
              <Select id="linkDocStatusFilter" width="100%" change=".onLinkDocFilterChange">
                <core:Item key="" text="All" />
                <core:Item key="New" text="New" />
                <core:Item key="In Work" text="In Work" />
                <core:Item key="Released" text="Released" />
              </Select>
            </VBox>
          </HBox>
        </VBox>

        <!-- Results table (mdc.Table with p13n settings) -->
        <VBox>
        <mdc:Table
          id="linkDocResultTable"
          header="Items"
          p13nMode="Column,Sort,Filter,Group"
          selectionMode="Multi"
          showRowCount="true"
          class="sapUiSizeCompact"
          delegate="{
            name: 'com/sap/demo/managespec/delegate/LinkDocTableDelegate',
            payload: {}
          }">
          <mdc:type>
            <mdct:ResponsiveTableType></mdct:ResponsiveTableType>
          </mdc:type>
          <mdct:Column propertyKey="docNumber"   header="Document No."     width="13rem"><Text text="{linkDoc>docNumber}"   wrapping="false" /></mdct:Column>
          <mdct:Column propertyKey="description" header="Description"                  ><Text text="{linkDoc>description}" wrapping="false" /></mdct:Column>
          <mdct:Column propertyKey="type"        header="Document Type"    width="9rem"><Text text="{linkDoc>type}"        wrapping="false" /></mdct:Column>
          <mdct:Column propertyKey="part"        header="Document Part"    width="7rem"><Text text="{linkDoc>part}"        wrapping="false" /></mdct:Column>
          <mdct:Column propertyKey="version"     header="Document Version" width="9rem"><Text text="{linkDoc>version}"     wrapping="false" /></mdct:Column>
          <mdct:Column propertyKey="status"      header="Document Status"  width="9rem"><Text text="{linkDoc>status}"      wrapping="false" /></mdct:Column>
        </mdc:Table>
        </VBox>

      </VBox>
    </content>

    <beginButton>
      <Button text="OK" type="Emphasized" press=".onLinkDocConfirm" width="auto" />
    </beginButton>
    <endButton>
      <Button text="Cancel" press=".onLinkDocCancel" width="auto" />
    </endButton>

  </Dialog>

</core:FragmentDefinition>
