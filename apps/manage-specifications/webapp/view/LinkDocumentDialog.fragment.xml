<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:l="sap.ui.layout"
  xmlns:t="sap.ui.table">

  <Dialog
    id="linkDocumentDialog"
    title="Link Documents"
    contentWidth="76rem"
    contentHeight="44rem"
    resizable="true"
    draggable="true"
    class="sapUiSizeCompact linkDoc3VHDialog">

    <content>
      <VBox fitContainer="true">

        <!-- Search row -->
        <Toolbar id="linkDocSearchRow" class="sapUiSizeCompact sapMTBTransparent linkDoc3VHSearchRow">
          <SearchField
            id="linkDocSearchField"
            placeholder="Search"
            search=".onLinkDocSearch"
            class="linkDoc3VHSearchField" />
          <ToolbarSpacer />
          <Button
            text="Go"
            type="Emphasized"
            press=".onLinkDocSearch"
            class="sapUiSizeCompact" />
          <Button
            id="linkDocShowFiltersBtn"
            text="Show Filters"
            type="Transparent"
            press=".onLinkDocShowFilters"
            class="sapUiSizeCompact" />
        </Toolbar>

        <!-- Collapsible filter panel -->
        <VBox id="linkDocFilterPanel" visible="false" class="linkDoc3FilterPanel">
          <l:Grid
            defaultSpan="L3 M3 S6"
            containerQuery="true"
            class="linkDoc3FilterGrid">
            <VBox class="linkDoc3FilterItem">
              <Label text="Document Type:" class="linkDoc3FilterLabel" />
              <Select id="linkDocTypeFilter" width="100%">
                <core:Item key="" text="All" />
                <core:Item key="DFT" text="DFT" />
                <core:Item key="DRW" text="DRW" />
                <core:Item key="TST" text="TST" />
                <core:Item key="IMU" text="IMU" />
              </Select>
            </VBox>
            <VBox class="linkDoc3FilterItem">
              <Label text="Status:" class="linkDoc3FilterLabel" />
              <Select id="linkDocStatusFilter" width="100%">
                <core:Item key="" text="All" />
                <core:Item key="New" text="New" />
                <core:Item key="In Work" text="In Work" />
                <core:Item key="Released" text="Released" />
              </Select>
            </VBox>
          </l:Grid>
        </VBox>

        <!-- Items count -->
        <Toolbar class="sapUiSizeCompact sapMTBTransparent linkDoc3ItemsToolbar">
          <Title id="linkDocItemsTitle" text="Items ({= ${linkDoc>/documents}.length})" level="H5" />
        </Toolbar>

        <!-- Grid Table -->
        <t:Table
          id="linkDocResultTable"
          rows="{linkDoc>/documents}"
          selectionMode="MultiToggle"
          selectionBehavior="Row"
          visibleRowCountMode="Auto"
          minAutoRowCount="5"
          noData="No documents found"
          class="sapUiSizeCompact linkDoc3GridTable">
          <t:columns>
            <t:Column width="17rem"><Label text="Attachment" /><t:template><HBox alignItems="Center"><core:Icon src="{linkDoc>fileIcon}" color="var(--sapContent_LabelColor)" useIconTooltip="false" class="sapUiTinyMarginEnd" /><Text text="{linkDoc>fileName}" wrapping="false" /></HBox></t:template></t:Column>
            <t:Column width="15rem"><Label text="Document" /><t:template><Text text="{linkDoc>docName}" wrapping="false" /></t:template></t:Column>
            <t:Column width="11rem"><Label text="Document No." /><t:template><Text text="{linkDoc>docNumber}" wrapping="false" /></t:template></t:Column>
            <t:Column width="9rem"><Label text="Document Type" /><t:template><Text text="{linkDoc>type}" wrapping="false" /></t:template></t:Column>
            <t:Column width="7rem"><Label text="Document Part" /><t:template><Text text="{linkDoc>part}" wrapping="false" /></t:template></t:Column>
            <t:Column width="8rem"><Label text="Document Version" /><t:template><Text text="{linkDoc>version}" wrapping="false" /></t:template></t:Column>
            <t:Column width="9rem"><Label text="Document Status" /><t:template><Text text="{linkDoc>status}" wrapping="false" /></t:template></t:Column>
          </t:columns>
        </t:Table>

      </VBox>
    </content>

    <beginButton>
      <Button text="OK" type="Emphasized" press=".onLinkDocConfirm" class="sapUiSizeCompact" width="auto" />
    </beginButton>
    <endButton>
      <Button text="Cancel" press=".onLinkDocCancel" class="sapUiSizeCompact" />
    </endButton>

  </Dialog>

</core:FragmentDefinition>
