<mvc:View
  controllerName="com.sap.demo.managespec.controller.Main"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page showHeader="false" enableScrolling="false" class="manageSpecPage">
    <content>
      <f:DynamicPage id="mainPage" class="mainDynamicPage" toggleHeaderOnTitleClick="false" showFooter="false" headerExpanded="true">

        <f:title>
          <f:DynamicPageTitle>
            <f:heading>
              <HBox alignItems="Center">
                <Title text="Standard" level="H2" class="sapUiSmallMarginEnd manageSpecTitle" />
                <Button icon="sap-icon://slim-arrow-down" type="Transparent" press=".onViewSwitchPress" />
              </HBox>
            </f:heading>
            <f:snappedHeading>
              <HBox alignItems="Center">
                <Title text="Standard" level="H2" class="sapUiSmallMarginEnd manageSpecTitle" />
                <Button icon="sap-icon://slim-arrow-down" type="Transparent" press=".onViewSwitchPress" />
              </HBox>
            </f:snappedHeading>
            <f:navigationActions>
              <Button icon="sap-icon://share-2" type="Transparent" tooltip="Share" press=".onSharePress" />
              <Button icon="sap-icon://navigation-down-arrow" type="Transparent" tooltip="More" press=".onSettingsPress" />
            </f:navigationActions>
          </f:DynamicPageTitle>
        </f:title>

        <f:header>
          <f:DynamicPageHeader pinnable="true">
            <VBox class="manageSpecFilterContainer sapUiSizeCompact">

              <!-- Row 1 -->
              <HBox class="manageSpecFilterRow manageSpecFilterRowTop" alignItems="End">
                <VBox class="manageSpecFilterItem">
                  <SearchField id="searchField" placeholder="Search" liveChange=".onSearch" />
                </VBox>
                <VBox class="manageSpecFilterItem">
                  <Label text="Editing Status:" labelFor="editingStatusFilter" />
                  <Select id="editingStatusFilter" width="100%" change=".onFilterChange">
                    <items>
                      <core:Item key="" text="All" />
                      <core:Item key="Draft" text="Draft" />
                      <core:Item key="Active" text="Active" />
                      <core:Item key="Locked" text="Locked" />
                    </items>
                  </Select>
                </VBox>
                <VBox class="manageSpecFilterItem">
                  <Label text="Number:" labelFor="numberInput" />
                  <Input id="numberInput" width="100%" showValueHelp="true" valueHelpRequest=".onNumberValueHelp" />
                </VBox>
                <VBox class="manageSpecFilterItem">
                  <Label text="Description:" labelFor="descriptionInput" />
                  <Input id="descriptionInput" width="100%" showValueHelp="true" valueHelpRequest=".onDescriptionValueHelp" />
                </VBox>
                <VBox class="manageSpecFilterItem">
                  <Label text="Type:" labelFor="typeInput" />
                  <Input id="typeInput" width="100%" showValueHelp="true" valueHelpRequest=".onTypeValueHelp" />
                </VBox>
                <VBox class="manageSpecFilterItem manageSpecFilterItemLast">
                  <Label text="Document Status:" labelFor="documentStatusInput" />
                  <Input id="documentStatusInput" width="100%" showValueHelp="true" valueHelpRequest=".onDocStatusValueHelp" />
                </VBox>
              </HBox>

              <!-- Row 2 -->
              <HBox class="manageSpecFilterRow" alignItems="End">
                <VBox class="manageSpecFilterItem">
                  <Label text="Version:" labelFor="versionInput" />
                  <Input id="versionInput" width="100%" showValueHelp="true" valueHelpRequest=".onVersionValueHelp" />
                </VBox>
                <VBox class="manageSpecFilterItem">
                  <Label text="Created By:" labelFor="createdByInput" />
                  <Input id="createdByInput" width="100%" showValueHelp="true" valueHelpRequest=".onCreatedByValueHelp" />
                </VBox>
                <HBox alignItems="Center" class="manageSpecGoActions">
                  <Button text="Go" type="Emphasized" press=".onGoPress" />
                  <Button text="Adapt Filters" type="Transparent" press=".onAdaptFiltersPress" />
                </HBox>
              </HBox>

            </VBox>
          </f:DynamicPageHeader>
        </f:header>

        <f:content>
          <VBox>

            <OverflowToolbar class="sapUiSizeCompact">
              <Title text="Documents (288)" level="H3" id="tableTitle" />
              <ToolbarSpacer />
              <Button id="createBtn" text="Create" type="Transparent" press=".onCreatePress" />
              <Button id="syncWithS4Btn" text="Sync with S4" type="Transparent" press=".onSyncWithS4Press" enabled="false" />
              <Button id="pullFromS4Btn" text="Pull from S4" type="Transparent" press=".onPullFromS4Press" />
              <Button id="deleteBtn" text="Delete" type="Transparent" press=".onDeletePress" enabled="false" />
              <Button icon="sap-icon://copy" type="Transparent" tooltip="Copy to clipboard" press=".onClipboardPress" />
              <Button icon="sap-icon://action-settings" type="Transparent" tooltip="Column settings" press=".onColumnSettingsPress" />
              <Button icon="sap-icon://group-2" type="Transparent" tooltip="Export" press=".onExportPress" />
            </OverflowToolbar>

            <Table
              id="specificationsTable"
              items="{/documents}"
              mode="MultiSelect"
              selectionChange=".onSelectionChange"
              noDataText="No documents found"
              sticky="ColumnHeaders,HeaderToolbar"
              growing="true"
              growingThreshold="20"
              class="sapUiSizeCompact">

              <columns>
                <Column width="10rem">
                  <Text text="Number" />
                </Column>
                <Column>
                  <Text text="Description" />
                </Column>
                <Column width="5rem">
                  <Text text="Type" />
                </Column>
                <Column width="6rem">
                  <Text text="Part" />
                </Column>
                <Column width="10rem">
                  <Text text="Document Status" />
                </Column>
                <Column width="8rem">
                  <Text text="Version" />
                </Column>
                <Column width="9rem">
                  <Text text="S4 Sync" />
                </Column>
              </columns>

              <items>
                <ColumnListItem type="Navigation" press=".onItemPress">
                  <cells>
                    <ObjectIdentifier title="{number}" titleActive="false" titlePress=".onItemPress" />
                    <Text text="{description}" wrapping="false" />
                    <Text text="{type}" wrapping="false" />
                    <ObjectIdentifier title="{part}" />
                    <Text text="{documentStatus}" wrapping="false" />
                    <ObjectIdentifier title="{version}" />
                    <ObjectStatus text="{s4SyncText}" state="{s4SyncState}" />
                  </cells>
                </ColumnListItem>
              </items>

            </Table>

          </VBox>
        </f:content>

      </f:DynamicPage>
    </content>
  </Page>

</mvc:View>
