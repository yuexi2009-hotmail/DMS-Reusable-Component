<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Dialog id="unlinkDialog" title="Unlink" class="sapUiSizeCompact">
    <content>
      <Text text="Do you want to unlink the selected document(s)? They will remain saved in the system." class="sapUiSmallMarginBeginEnd sapUiSmallMarginTopBottom" />
    </content>
    <beginButton>
      <Button text="Unlink" type="Emphasized" press=".onDoc7UnlinkConfirm" />
    </beginButton>
    <endButton>
      <Button text="Cancel" press=".onDoc7UnlinkCancel" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
