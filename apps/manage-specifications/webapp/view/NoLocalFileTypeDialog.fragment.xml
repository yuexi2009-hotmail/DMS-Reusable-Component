<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog
    id="noLocalFileTypeDialog"
    title="No Local Document Type Found"
    contentWidth="32rem"
    resizable="false"
    draggable="true"
    class="sapUiSizeCompact">

    <content>
      <Text
        text="No local document type was found. To upload and manage files locally, please configure a local document type in the Document Configuration settings first."
        class="sapUiSmallMarginBeginEnd sapUiTinyMarginTopBottom" />
    </content>

    <beginButton>
      <Button text="Configure Document Type" type="Emphasized" press=".onConfigureFileType" width="auto" />
    </beginButton>
    <endButton>
      <Button text="Cancel" press=".onConfigureFileTypeCancel" width="auto" />
    </endButton>

  </Dialog>

</core:FragmentDefinition>
