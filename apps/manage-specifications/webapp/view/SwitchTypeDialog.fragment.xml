<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog
    id="switchTypeDialog"
    title="Switch Type"
    contentWidth="22rem"
    resizable="false"
    draggable="true"
    class="sapUiSizeCompact">

    <content>
      <VBox class="sapUiSmallMarginBeginEnd sapUiSmallMarginTopBottom">
        <MessageStrip
          text="Once the type is switched from ATT to another type, it cannot be changed again. Please proceed with caution."
          type="Warning"
          showIcon="true"
          class="sapUiSmallMarginBottom" />
        <RadioButtonGroup id="switchTypeRBGroup" columns="1">
          <RadioButton id="switchTypeRB_ATT" text="ATT" />
          <RadioButton id="switchTypeRB_DFT" text="DFT" />
          <RadioButton id="switchTypeRB_DRW" text="DRW" />
          <RadioButton id="switchTypeRB_TST" text="TST" />
          <RadioButton id="switchTypeRB_IMU" text="IMU" />
        </RadioButtonGroup>
      </VBox>
    </content>

    <beginButton>
      <Button text="OK" type="Emphasized" press=".onSwitchTypeConfirm" class="sapUiSizeCompact" />
    </beginButton>
    <endButton>
      <Button text="Cancel" press=".onSwitchTypeCancel" class="sapUiSizeCompact" />
    </endButton>

  </Dialog>

</core:FragmentDefinition>
