<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog
    id="switchTypeDialog"
    title="Change Type"
    contentWidth="30rem"
    resizable="false"
    draggable="true"
    class="sapUiSizeCompact">

    <content>
      <VBox class="sapUiSmallMarginBeginEnd sapUiSmallMarginTopBottom">
        <MessageStrip
          text="Once the type is switched from ATT to another type, it cannot be changed again. Please proceed with caution."
          type="Warning"
          showIcon="true"
          class="sapUiSmallMarginBottom" />
        <Text text="After changing the type, future file management operations must be performed in Document Management System (DMS). Current files will become read-only." class="sapUiSmallMarginBottom" wrapping="true" />
        <Label text="Document Type:" labelFor="switchTypeSelect" class="doc7SwitchTypeLabel" />
        <Select id="switchTypeSelect" width="100%">
          <core:Item key="DFT" text="DFT" />
          <core:Item key="DRW" text="DRW" />
          <core:Item key="TST" text="TST" />
          <core:Item key="IMU" text="IMU" />
        </Select>
      </VBox>
    </content>

    <beginButton>
      <Button text="OK" type="Emphasized" press=".onSwitchTypeConfirm" width="auto" />
    </beginButton>
    <endButton>
      <Button text="Cancel" press=".onSwitchTypeCancel" width="auto" />
    </endButton>

  </Dialog>

</core:FragmentDefinition>
