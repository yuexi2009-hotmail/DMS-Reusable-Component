<mvc:View
  id="detailView"
  controllerName="com.sap.demo.managespec.controller.Detail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:l="sap.ui.layout"
  xmlns:form="sap.ui.layout.form"
  xmlns:uxap="sap.uxap"
  xmlns:ui="sap.ui.table"
  xmlns:core="sap.ui.core"
  xmlns:mdc="sap.ui.mdc"
  xmlns:mdct="sap.ui.mdc.table"
  displayBlock="true">

  <Page showHeader="false" enableScrolling="false" class="detailPage">
    <content>
      <f:DynamicPage id="detailPage" toggleHeaderOnTitleClick="true" showFooter="false" stickySubheaderProvider="detailTabBar">

        <f:title>
          <f:DynamicPageTitle class="sapUiSizeCompact">
            <f:heading>
              <VBox>
                <Title text="{detail>/name}" level="H2" />
                <Text text="{detail>/technicalName}" class="detailSpecSubtitle" />
              </VBox>
            </f:heading>
            <f:snappedHeading>
              <VBox>
                <Title text="{detail>/name}" level="H3" />
                <Text text="{detail>/technicalName}" class="detailSpecSubtitle" />
              </VBox>
            </f:snappedHeading>
            <f:actions>
              <Button text="Delete" type="Ghost" />
              <Button text="Copy" type="Ghost" />
              <Button text="Change Product Category" type="Ghost" />
              <Button text="Transfer Data" type="Ghost" />
              <Button text="New Version" type="Ghost" />
              <Button icon="sap-icon://action" type="Transparent" />
            </f:actions>
          </f:DynamicPageTitle>
        </f:title>

        <f:header>
          <f:DynamicPageHeader pinnable="true">
            <HBox alignItems="Start" class="sapUiMediumMarginBottom">
              <Avatar src="sap-icon://product" displayShape="Square" class="detailHeaderAvatar sapUiMediumMarginEnd" />
              <VBox class="sapUiMediumMarginEnd detailHeaderCol">
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                  <Label text="Version:" class="detailAttrLabel sapUiTinyMarginEnd" />
                  <Text text="{detail>/version}" />
                </HBox>
                <HBox alignItems="Center">
                  <Label text="Status:" class="detailAttrLabel sapUiTinyMarginEnd" />
                  <ObjectStatus text="{detail>/statusText}" state="{detail>/statusState}" icon="{detail>/statusIcon}" />
                </HBox>
              </VBox>
              <VBox class="detailHeaderCol">
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                  <Label text="Specification Type:" class="detailAttrLabel sapUiTinyMarginEnd" />
                  <Text text="{detail>/specType}" />
                </HBox>
                <HBox alignItems="Center">
                  <Label text="Product Category:" class="detailAttrLabel sapUiTinyMarginEnd" />
                  <Text text="{detail>/productCategory}" />
                </HBox>
              </VBox>
            </HBox>
          </f:DynamicPageHeader>
        </f:header>

        <f:content>
          <IconTabBar id="detailTabBar" class="detailTabBar sapUiNoContentPadding" expanded="true" select=".onTabSelect">
            <items>

              <!-- General Tab -->
              <IconTabFilter text="General" key="general">
                <uxap:ObjectPageLayout
                  id="generalObjectPage"
                  useIconTabBar="false"
                  upperCaseAnchorBar="false"
                  showTitleInHeaderContent="false"
                  alwaysShowContentHeader="false"
                  preserveHeaderStateOnScroll="false"
                  showAnchorBar="false"
                  showHeaderContent="false"
                  enableLazyLoading="false"
                  class="detailGeneralPage">
                  <uxap:sections>

                    <uxap:ObjectPageSection title=" " titleUppercase="false">
                      <uxap:subSections>
                        <uxap:ObjectPageSubSection title=" ">
                          <uxap:blocks>
                            <VBox width="100%">
                              <Toolbar class="sapUiSizeCompact detailSectionToolbar detailPlainToolbar">
                                <Title text="Basic Data" level="H4" />
                              </Toolbar>
                              <form:SimpleForm
                                layout="ColumnLayout"
                                columnsM="2" columnsL="4" columnsXL="4"
                                class="sapUxAPObjectPageSubSectionAlignContent">
                                <Label text="ID" />
                                <Text text="{detail>/id}" />
                                <Label text="Status" />
                                <ObjectStatus text="{detail>/statusText}" state="{detail>/statusState}" />
                                <Label text="Name" />
                                <Text text="{detail>/name}" />
                                <Label text="Product Category" />
                                <Text text="{detail>/productCategory}" />
                                <Label text="Version" />
                                <Text text="{detail>/version}" />
                                <Label text="Specification Type" />
                                <Text text="{detail>/specType}" />
                              </form:SimpleForm>
                            </VBox>
                          </uxap:blocks>
                        </uxap:ObjectPageSubSection>
                      </uxap:subSections>
                    </uxap:ObjectPageSection>

                    <uxap:ObjectPageSection title=" " titleUppercase="false">
                      <uxap:subSections>
                        <uxap:ObjectPageSubSection title=" ">
                          <uxap:blocks>
                            <VBox width="100%">
                              <Toolbar class="sapUiSizeCompact detailSectionToolbar">
                                <Title text="Other Versions" level="H4" />
                                <ToolbarSpacer />
                                <SearchField placeholder="Search" width="14rem" />
                                <Button icon="sap-icon://action-settings" type="Transparent" />
                                <Button icon="sap-icon://slim-arrow-down" type="Transparent" />
                              </Toolbar>
                              <Table items="{detail>/otherVersions}" class="sapUiSizeCompact detailTable">
                                <columns>
                                  <Column><Text text="Name" /></Column>
                                  <Column width="8rem"><Text text="Version" /></Column>
                                  <Column><Text text="Status" /></Column>
                                </columns>
                                <items>
                                  <ColumnListItem>
                                    <cells>
                                      <Text text="{name}" />
                                      <Text text="{version}" />
                                      <ObjectStatus text="{statusText}" state="{statusState}" />
                                    </cells>
                                  </ColumnListItem>
                                </items>
                                <noData>
                                  <IllustratedMessage illustrationType="sapIllus-NoData" illustrationSize="Dot"
                                    title="No items available" description="When there are, you'll find them here." />
                                </noData>
                              </Table>
                            </VBox>
                          </uxap:blocks>
                        </uxap:ObjectPageSubSection>
                      </uxap:subSections>
                    </uxap:ObjectPageSection>

                  </uxap:sections>
                </uxap:ObjectPageLayout>
              </IconTabFilter>

              <!-- Properties Tab -->
              <IconTabFilter text="Properties" key="properties">
                <VBox class="detailTabContent">
                  <VBox>
                    <Toolbar class="sapUiSizeCompact detailSectionToolbar">
                      <Title text="Properties" level="H4" />
                      <ToolbarSpacer />
                      <SearchField placeholder="Search" width="14rem" />
                      <Button icon="sap-icon://action-settings" type="Transparent" />
                      <Button icon="sap-icon://slim-arrow-down" type="Transparent" />
                    </Toolbar>
                    <Table items="{detail>/properties}" class="sapUiSizeCompact detailTable">
                      <columns>
                        <Column><Text text="Name" /></Column>
                        <Column><Text text="Value" /></Column>
                        <Column><Text text="Unit" /></Column>
                      </columns>
                      <items>
                        <ColumnListItem>
                          <cells>
                            <Text text="{name}" />
                            <Text text="{value}" />
                            <Text text="{unit}" />
                          </cells>
                        </ColumnListItem>
                      </items>
                      <noData>
                        <IllustratedMessage illustrationType="sapIllus-NoData" illustrationSize="Dot"
                          title="No items available" description="When there are, you'll find them here." />
                      </noData>
                    </Table>
                  </VBox>
                </VBox>
              </IconTabFilter>

              <!-- Related Objects Tab -->
              <IconTabFilter text="Related Objects" key="relatedObjects">
                <VBox class="detailTabContent">
                  <VBox>
                    <Toolbar class="sapUiSizeCompact detailSectionToolbar">
                      <Title text="Collaborations" level="H4" />
                      <ToolbarSpacer />
                      <SearchField placeholder="Search" width="14rem" />
                      <Button icon="sap-icon://action-settings" type="Transparent" />
                      <Button icon="sap-icon://slim-arrow-down" type="Transparent" />
                    </Toolbar>
                    <Table items="{detail>/collaborations}" class="sapUiSizeCompact detailTable">
                      <columns>
                        <Column><Text text="Name" /></Column>
                        <Column><Text text="Description" /></Column>
                        <Column width="10rem"><Text text="Created On" /></Column>
                        <Column><Text text="Created By" /></Column>
                      </columns>
                      <items>
                        <ColumnListItem>
                          <cells>
                            <Text text="{name}" />
                            <Text text="{description}" />
                            <Text text="{createdOn}" />
                            <Text text="{createdBy}" />
                          </cells>
                        </ColumnListItem>
                      </items>
                      <noData>
                        <IllustratedMessage illustrationType="sapIllus-NoData" illustrationSize="Dot"
                          title="No items available" description="When there are, you'll find them here." />
                      </noData>
                    </Table>
                  </VBox>
                </VBox>
              </IconTabFilter>

              <!-- Documents Tab -->
              <IconTabFilter text="Documents" key="documents">
                <VBox class="detailTabContent">
                  <Toolbar class="sapUiSizeCompact detailSectionToolbar">
                    <Title text="Items ({= ${detail>/documents}.length})" level="H4" />
                    <ToolbarSpacer />
                    <SearchField placeholder="Search" width="16rem" />
                    <FacetFilter id="docFacetFilter" type="Simple" showReset="false" showPersonalization="true"
                      confirm=".onDocFilterDialogConfirm" reset=".onDocFilterDialogReset"
                      class="sapUiSizeCompact">
                      <lists>
                        <FacetFilterList title="Type" key="type" active="false">
                          <items>
                            <FacetFilterItem text="NEW" key="NEW" />
                            <FacetFilterItem text="IMU" key="IMU" />
                            <FacetFilterItem text="TES" key="TES" />
                            <FacetFilterItem text="DRW" key="DRW" />
                          </items>
                        </FacetFilterList>
                        <FacetFilterList title="Part" key="part" active="false">
                          <items>
                            <FacetFilterItem text="000" key="000" />
                            <FacetFilterItem text="001" key="001" />
                          </items>
                        </FacetFilterList>
                        <FacetFilterList title="Version" key="version" active="false">
                          <items>
                            <FacetFilterItem text="000001" key="000001" />
                            <FacetFilterItem text="000002" key="000002" />
                            <FacetFilterItem text="000003" key="000003" />
                          </items>
                        </FacetFilterList>
                        <FacetFilterList title="Document Status" key="status" active="false">
                          <items>
                            <FacetFilterItem text="New" key="New" />
                            <FacetFilterItem text="In Work" key="In Work" />
                            <FacetFilterItem text="Locked" key="Locked" />
                            <FacetFilterItem text="Created" key="Created" />
                            <FacetFilterItem text="Update" key="Update" />
                          </items>
                        </FacetFilterList>
                      </lists>
                    </FacetFilter>
                    <MenuButton text="Link" type="Transparent" buttonMode="Regular" menuPosition="BeginBottom">
                      <menu>
                        <Menu>
                          <items>
                            <MenuItem text="Link Existing Document" press=".onLinkExistingDoc3" />
                            <MenuItem text="Link New Document" />
                          </items>
                        </Menu>
                      </menu>
                    </MenuButton>
                    <Button id="unlinkBtn" text="Unlink Document" type="Transparent" enabled="false" press=".onUnlinkDocument" />
                    <Button icon="sap-icon://action-settings" type="Transparent" />
                  </Toolbar>
                  <ui:TreeTable
                    id="documentsTreeTable"
                    rows="{path: 'detail>/documents', parameters: {arrayNames: ['children']}}"
                    selectionMode="MultiToggle"
                    visibleRowCountMode="Fixed"
                    visibleRowCount="4"
                    rowHeight="48"
                    columnHeaderHeight="32"
                    rowSelectionChange=".onDocSelectionChange"
                    toggleOpenState=".onDocTreeToggle"
                    class="sapUiSizeCompact detailTreeTable">
                    <ui:columns>
                      <ui:Column width="28rem">
                        <Label text="Document Info" />
                        <ui:template>
                          <VBox justifyContent="Center">
                            <FormattedText htmlText="{= ${detail>isParent} === true ? ('&lt;strong&gt;' + ${detail>docNumber} + '&lt;/strong&gt;') : '' }" />
                            <Text text="{detail>docDescription}" class="detailDocDescription" visible="{= ${detail>isParent} === true }" />
                            <HBox alignItems="Center" visible="{= ${detail>isParent} !== true }">
                              <core:Icon src="{path: 'detail>description', formatter: '.formatAttachmentIcon'}" useIconTooltip="false" class="doc3AttIcon" />
                              <Text text="{detail>description}" />
                            </HBox>
                          </VBox>
                        </ui:template>
                      </ui:Column>
                      <ui:Column width="8rem">
                        <Label text="Type" />
                        <ui:template>
                          <Text text="{= ${detail>isParent} === true ? ${detail>type} : '' }" />
                        </ui:template>
                      </ui:Column>
                      <ui:Column width="8rem">
                        <Label text="Part" />
                        <ui:template>
                          <Text text="{= ${detail>isParent} === true ? ${detail>part} : '' }" />
                        </ui:template>
                      </ui:Column>
                      <ui:Column width="8rem">
                        <Label text="Version" />
                        <ui:template>
                          <Text text="{= ${detail>isParent} === true ? ${detail>version} : '' }" />
                        </ui:template>
                      </ui:Column>
                      <ui:Column width="8rem">
                        <Label text="Document Status" />
                        <ui:template>
                          <Text text="{= ${detail>isParent} === true ? ${detail>status} : '' }" />
                        </ui:template>
                      </ui:Column>
                      <ui:Column width="3rem" hAlign="End">
                        <Label text="" />
                        <ui:template>
                          <core:Icon
                            src="sap-icon://navigation-right-arrow"
                            color="var(--sapHighlightColor)"
                            visible="{= ${detail>isParent} === true }"
                            press=".onDocumentNavigate"
                            useIconTooltip="false"
                            class="sapUiSmallMarginEnd" />
                        </ui:template>
                      </ui:Column>
                    </ui:columns>
                  </ui:TreeTable>
                </VBox>
              </IconTabFilter>

              <!-- Documents 3 Tab: flat sap.m.Table, SAP-standard style -->
              <IconTabFilter text="Documents 3" key="documents3">
                <VBox class="detailTabContent">
                  <Toolbar class="sapUiSizeCompact detailSectionToolbar">
                    <Title text="Items ({= ${detail>/documentsFlat}.length})" level="H4" />
                    <ToolbarSpacer />
                    <SearchField placeholder="Search" width="16rem" />
                    <FacetFilter id="doc3FacetFilter" type="Simple" showReset="false" showPersonalization="true"
                      confirm=".onDocFilterDialogConfirm" reset=".onDocFilterDialogReset"
                      class="sapUiSizeCompact">
                      <lists>
                        <FacetFilterList title="Type" key="type" active="false">
                          <items>
                            <FacetFilterItem text="NEW" key="NEW" />
                            <FacetFilterItem text="IMU" key="IMU" />
                            <FacetFilterItem text="TES" key="TES" />
                            <FacetFilterItem text="DRW" key="DRW" />
                          </items>
                        </FacetFilterList>
                        <FacetFilterList title="Part" key="part" active="false">
                          <items>
                            <FacetFilterItem text="000" key="000" />
                            <FacetFilterItem text="001" key="001" />
                          </items>
                        </FacetFilterList>
                        <FacetFilterList title="Version" key="version" active="false">
                          <items>
                            <FacetFilterItem text="000001" key="000001" />
                            <FacetFilterItem text="000002" key="000002" />
                            <FacetFilterItem text="000003" key="000003" />
                          </items>
                        </FacetFilterList>
                        <FacetFilterList title="Document Status" key="status" active="false">
                          <items>
                            <FacetFilterItem text="New" key="New" />
                            <FacetFilterItem text="In Work" key="In Work" />
                            <FacetFilterItem text="Locked" key="Locked" />
                            <FacetFilterItem text="Created" key="Created" />
                            <FacetFilterItem text="Update" key="Update" />
                          </items>
                        </FacetFilterList>
                      </lists>
                    </FacetFilter>
                    <MenuButton text="Link" type="Transparent" buttonMode="Regular" menuPosition="BeginBottom">
                      <menu>
                        <Menu>
                          <items>
                            <MenuItem text="Link Existing Document" press=".onLinkExistingDoc3" />
                            <MenuItem text="Link New Document" />
                          </items>
                        </Menu>
                      </menu>
                    </MenuButton>
                    <Button id="unlinkBtn3" text="Unlink Document" type="Transparent" enabled="false" press=".onUnlinkDocument" />
                    <Button icon="sap-icon://action-settings" type="Transparent" />
                  </Toolbar>
                  <Table
                    id="documentsTable3"
                    items="{detail>/documentsFlat}"
                    mode="MultiSelect"
                    noDataText="No documents linked"
                    growing="true"
                    growingThreshold="20"
                    selectionChange=".onDoc3SelectionChange"
                    class="sapUiSizeCompact detailTable">
                    <columns>
                      <Column width="18rem">
                        <Text text="Document Name" />
                      </Column>
                      <Column width="20rem">
                        <Text text="Attachments" />
                      </Column>
                      <Column width="8rem">
                        <Text text="Document Type" />
                      </Column>
                      <Column width="8rem">
                        <Text text="Document Part" />
                      </Column>
                      <Column width="8rem">
                        <Text text="Document Version" />
                      </Column>
                      <Column width="8rem">
                        <Text text="Document Status" />
                      </Column>
                    </columns>
                    <items>
                      <ColumnListItem type="Navigation" press=".onDoc3ItemPress">
                        <cells>
                          <VBox>
                            <Text text="{detail>docNumber}" class="detailDocNumber" />
                            <Text text="{detail>docName}" class="detailDocMeta" />
                          </VBox>
                          <VBox class="doc3AttBox">
                            <List
                              items="{path: 'detail>attachments', templateShareable: true}"
                              showNoData="false"
                              class="sapUiNoContentPadding doc3AttList">
                              <CustomListItem>
                                <HBox alignItems="Center" renderType="Bare" class="doc3AttRow">
                                  <core:Icon
                                    src="{path: 'detail>', formatter: '.formatAttachmentIcon'}"
                                    useIconTooltip="false"
                                    class="doc3AttIcon" />
                                  <Text text="{detail>}" class="doc3AttItem" />
                                </HBox>
                              </CustomListItem>
                            </List>
                            <Link
                              text="{parts: [{path: 'detail>showAll'}], formatter: '.formatShowAllText'}"
                              visible="{parts: [{path: 'detail>showAll'}, {path: 'detail>attachments'}], formatter: '.formatShowAllVisible'}"
                              press=".onDoc3ShowAll" />
                          </VBox>
                          <Text text="{detail>type}" />
                          <Text text="{detail>part}" />
                          <Text text="{detail>version}" />
                          <Text text="{detail>status}" />
                        </cells>
                      </ColumnListItem>
                    </items>
                  </Table>
                </VBox>
              </IconTabFilter>

              <!-- Documents 4 Tab: left-side list; clicking a row opens FCL midColumn -->
              <IconTabFilter text="Documents 5" key="documents5">
                <VBox class="detailTabContent">
                  <mdc:Table
                    id="documentsTable5"
                    header="Items"
                    p13nMode="Column,Sort,Group"
                    selectionMode="Multi"
                    showRowCount="true"
                    class="sapUiSizeCompact"
                    selectionChange=".onDoc5SelectionChange"
                    groupConditions='{"groupLevels": [{"name": "docName"}]}'
                    delegate='{"name": "com/sap/demo/managespec/delegate/Doc5TableDelegate"}'>
                    <mdc:actions>
                      <SearchField id="doc5SearchField" placeholder="Search" width="16rem" search=".onDoc5Search">
                        <layoutData><mdct:ActionLayoutData priority="NeverOverflow" /></layoutData>
                      </SearchField>
                      <FacetFilter id="doc5FacetFilter" type="Simple" showReset="false" showPersonalization="true"
                        confirm=".onDocFilterDialogConfirm" reset=".onDocFilterDialogReset"
                        class="sapUiSizeCompact">
                        <layoutData><mdct:ActionLayoutData priority="NeverOverflow" /></layoutData>
                        <lists>
                          <FacetFilterList title="Type" key="type" active="false">
                            <items>
                              <FacetFilterItem text="NEW" key="NEW" />
                              <FacetFilterItem text="IMU" key="IMU" />
                              <FacetFilterItem text="TES" key="TES" />
                              <FacetFilterItem text="DRW" key="DRW" />
                            </items>
                          </FacetFilterList>
                          <FacetFilterList title="Part" key="part" active="false">
                            <items>
                              <FacetFilterItem text="000" key="000" />
                              <FacetFilterItem text="001" key="001" />
                            </items>
                          </FacetFilterList>
                          <FacetFilterList title="Version" key="version" active="false">
                            <items>
                              <FacetFilterItem text="000001" key="000001" />
                              <FacetFilterItem text="000002" key="000002" />
                              <FacetFilterItem text="000003" key="000003" />
                            </items>
                          </FacetFilterList>
                          <FacetFilterList title="Document Status" key="status" active="false">
                            <items>
                              <FacetFilterItem text="New" key="New" />
                              <FacetFilterItem text="In Work" key="In Work" />
                              <FacetFilterItem text="Locked" key="Locked" />
                              <FacetFilterItem text="Created" key="Created" />
                              <FacetFilterItem text="Update" key="Update" />
                            </items>
                          </FacetFilterList>
                        </lists>
                      </FacetFilter>
                      <MenuButton id="doc5LinkMenuBtn" text="Link" type="Transparent" buttonMode="Regular" menuPosition="BeginBottom">
                        <menu>
                          <Menu>
                            <items>
                              <MenuItem text="Link Existing Document" press=".onLinkExistingDoc3" />
                              <MenuItem text="Link New Document" />
                            </items>
                          </Menu>
                        </menu>
                        <layoutData><mdct:ActionLayoutData priority="NeverOverflow" /></layoutData>
                      </MenuButton>
                      <Button id="doc5UnlinkBtn" text="Unlink Document" type="Transparent" enabled="false" press=".onDoc5Unlink">
                        <layoutData>
                          <mdct:ActionLayoutData priority="NeverOverflow" />
                        </layoutData>
                      </Button>
                    </mdc:actions>
                    <mdc:type>
                      <mdct:ResponsiveTableType showDetailsButton="true" />
                    </mdc:type>
                    <mdct:Column propertyKey="fileName" header="Attachment">
                      <HBox alignItems="Center">
                        <core:Icon src="{path: 'detail>fileName', formatter: '.formatAttachmentIcon'}" class="doc3AttIcon" />
                        <Text text="{detail>fileName}" wrapping="false" />
                      </HBox>
                    </mdct:Column>
                    <mdct:Column propertyKey="docName" header="Document">
                      <Text text="{detail>docName}" wrapping="false" />
                    </mdct:Column>
                    <mdct:Column propertyKey="docNumber" header="Document No." width="10rem">
                      <Text text="{detail>docNumber}" wrapping="false" />
                    </mdct:Column>
                    <mdct:Column propertyKey="type" header="Document Type" width="7rem">
                      <Text text="{detail>type}" />
                    </mdct:Column>
                    <mdct:Column propertyKey="part" header="Document Part" width="7rem">
                      <Text text="{detail>part}" />
                    </mdct:Column>
                    <mdct:Column propertyKey="version" header="Document Version" width="7rem">
                      <Text text="{detail>version}" />
                    </mdct:Column>
                    <mdct:Column propertyKey="status" header="Document Status" width="7rem">
                      <Text text="{detail>status}" />
                    </mdct:Column>
                    <mdct:Column propertyKey="nav" header="" width="3rem" importance="High">
                      <core:Icon src="sap-icon://slim-arrow-right" class="doc5NavIcon" />
                    </mdct:Column>
                  </mdc:Table>
                </VBox>
              </IconTabFilter>

            </items>
          </IconTabBar>
        </f:content>

      </f:DynamicPage>
    </content>
  </Page>

</mvc:View>
