<mvc:View
  controllerName="com.sap.demo.managespec.controller.Detail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:form="sap.ui.layout.form"
  xmlns:uxap="sap.uxap"
  xmlns:ui="sap.ui.table"
  displayBlock="true">

  <Page showHeader="false" enableScrolling="false" class="detailPage">
    <content>
      <f:DynamicPage id="detailPage" toggleHeaderOnTitleClick="true" showFooter="false" stickySubheaderProvider="detailTabBar">

        <f:title>
          <f:DynamicPageTitle class="sapUiSizeCompact">
            <f:heading>
              <VBox>
                <Title text="{detail>/name}" level="H2" />
                <Text text="{detail>/technicalName}" class="detailSpecSubtitle" />
              </VBox>
            </f:heading>
            <f:snappedHeading>
              <VBox>
                <Title text="{detail>/name}" level="H3" />
                <Text text="{detail>/technicalName}" class="detailSpecSubtitle" />
              </VBox>
            </f:snappedHeading>
            <f:actions>
              <Button text="Delete" type="Ghost" />
              <Button text="Copy" type="Ghost" />
              <Button text="Change Product Category" type="Ghost" />
              <Button text="Transfer Data" type="Ghost" />
              <MenuButton text="Next Steps" type="Ghost" buttonMode="Regular" menuPosition="BeginBottom">
                <menu>
                  <Menu>
                    <items>
                      <MenuItem text="Submit for Review" />
                      <MenuItem text="Release" />
                      <MenuItem text="Block" />
                    </items>
                  </Menu>
                </menu>
              </MenuButton>
              <Button text="New Version" type="Ghost" />
              <Button icon="sap-icon://action" type="Transparent" />
            </f:actions>
          </f:DynamicPageTitle>
        </f:title>

        <f:header>
          <f:DynamicPageHeader pinnable="true">
            <HBox alignItems="Start" class="sapUiMediumMarginBottom">
              <Avatar src="sap-icon://product" displayShape="Square" class="detailHeaderAvatar sapUiMediumMarginEnd" />
              <VBox class="sapUiMediumMarginEnd detailHeaderCol">
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                  <Label text="Version:" class="detailAttrLabel sapUiTinyMarginEnd" />
                  <Text text="{detail>/version}" />
                </HBox>
                <HBox alignItems="Center">
                  <Label text="Status:" class="detailAttrLabel sapUiTinyMarginEnd" />
                  <ObjectStatus text="{detail>/statusText}" state="{detail>/statusState}" icon="{detail>/statusIcon}" />
                </HBox>
              </VBox>
              <VBox class="detailHeaderCol">
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                  <Label text="Specification Type:" class="detailAttrLabel sapUiTinyMarginEnd" />
                  <Text text="{detail>/specType}" />
                </HBox>
                <HBox alignItems="Center">
                  <Label text="Product Category:" class="detailAttrLabel sapUiTinyMarginEnd" />
                  <Text text="{detail>/productCategory}" />
                </HBox>
              </VBox>
            </HBox>
          </f:DynamicPageHeader>
        </f:header>

        <f:content>
          <IconTabBar id="detailTabBar" class="detailTabBar sapUiNoContentPadding" expanded="true" select=".onTabSelect">
            <items>

              <!-- General Tab -->
              <IconTabFilter text="General" key="general">
                <uxap:ObjectPageLayout
                  id="generalObjectPage"
                  useIconTabBar="false"
                  upperCaseAnchorBar="false"
                  showTitleInHeaderContent="false"
                  alwaysShowContentHeader="false"
                  preserveHeaderStateOnScroll="false"
                  showAnchorBar="false"
                  showHeaderContent="false"
                  enableLazyLoading="false"
                  class="detailGeneralPage">
                  <uxap:sections>

                    <uxap:ObjectPageSection title=" " titleUppercase="false">
                      <uxap:subSections>
                        <uxap:ObjectPageSubSection title=" ">
                          <uxap:blocks>
                            <VBox width="100%">
                              <Toolbar class="sapUiSizeCompact detailSectionToolbar detailPlainToolbar">
                                <Title text="Basic Data" level="H4" />
                              </Toolbar>
                              <form:SimpleForm
                                layout="ColumnLayout"
                                columnsM="2" columnsL="4" columnsXL="4"
                                class="sapUxAPObjectPageSubSectionAlignContent">
                                <Label text="ID" />
                                <Text text="{detail>/id}" />
                                <Label text="Status" />
                                <ObjectStatus text="{detail>/statusText}" state="{detail>/statusState}" />
                                <Label text="Name" />
                                <Text text="{detail>/name}" />
                                <Label text="Product Category" />
                                <Text text="{detail>/productCategory}" />
                                <Label text="Version" />
                                <Text text="{detail>/version}" />
                                <Label text="Specification Type" />
                                <Text text="{detail>/specType}" />
                              </form:SimpleForm>
                            </VBox>
                          </uxap:blocks>
                        </uxap:ObjectPageSubSection>
                      </uxap:subSections>
                    </uxap:ObjectPageSection>

                    <uxap:ObjectPageSection title=" " titleUppercase="false">
                      <uxap:subSections>
                        <uxap:ObjectPageSubSection title=" ">
                          <uxap:blocks>
                            <VBox width="100%">
                              <Toolbar class="sapUiSizeCompact detailSectionToolbar">
                                <Title text="Other Versions" level="H4" />
                                <ToolbarSpacer />
                                <SearchField placeholder="Search" width="14rem" />
                                <Button icon="sap-icon://action-settings" type="Transparent" />
                                <Button icon="sap-icon://slim-arrow-down" type="Transparent" />
                              </Toolbar>
                              <Table items="{detail>/otherVersions}" class="sapUiSizeCompact detailTable">
                                <columns>
                                  <Column><Text text="Name" /></Column>
                                  <Column width="8rem"><Text text="Version" /></Column>
                                  <Column><Text text="Status" /></Column>
                                </columns>
                                <items>
                                  <ColumnListItem>
                                    <cells>
                                      <Text text="{name}" />
                                      <Text text="{version}" />
                                      <ObjectStatus text="{statusText}" state="{statusState}" />
                                    </cells>
                                  </ColumnListItem>
                                </items>
                                <noData>
                                  <IllustratedMessage illustrationType="sapIllus-NoData" illustrationSize="Dot"
                                    title="No items available" description="When there are, you'll find them here." />
                                </noData>
                              </Table>
                            </VBox>
                          </uxap:blocks>
                        </uxap:ObjectPageSubSection>
                      </uxap:subSections>
                    </uxap:ObjectPageSection>

                  </uxap:sections>
                </uxap:ObjectPageLayout>
              </IconTabFilter>

              <!-- Properties Tab -->
              <IconTabFilter text="Properties" key="properties">
                <VBox class="detailTabContent">
                  <IllustratedMessage illustrationType="sapIllus-EmptyList" illustrationSize="Scene"
                    title="No data" description="No properties have been defined yet." />
                </VBox>
              </IconTabFilter>

              <!-- Related Objects Tab -->
              <IconTabFilter text="Related Objects" key="relatedObjects">
                <VBox class="detailTabContent">
                  <VBox>
                    <Toolbar class="sapUiSizeCompact detailSectionToolbar">
                      <Title text="Collaborations" level="H4" />
                      <ToolbarSpacer />
                      <Button text="Add" type="Transparent" />
                      <Button text="Remove" type="Transparent" enabled="false" />
                      <Button icon="sap-icon://slim-arrow-down" type="Transparent" />
                    </Toolbar>
                    <Table items="{detail>/collaborations}" mode="MultiSelect" class="sapUiSizeCompact detailTable">
                      <columns>
                        <Column><Text text="Name" /></Column>
                        <Column><Text text="Description" /></Column>
                        <Column width="10rem"><Text text="Created On" /></Column>
                        <Column><Text text="Created By" /></Column>
                      </columns>
                      <items>
                        <ColumnListItem>
                          <cells>
                            <Text text="{name}" />
                            <Text text="{description}" />
                            <Text text="{createdOn}" />
                            <Text text="{createdBy}" />
                          </cells>
                        </ColumnListItem>
                      </items>
                      <noData>
                        <IllustratedMessage illustrationType="sapIllus-EmptyList" illustrationSize="Scene"
                          title="No items available" description="When there are, you'll find them here." />
                      </noData>
                    </Table>
                  </VBox>
                </VBox>
              </IconTabFilter>

              <!-- Documents Tab -->
              <IconTabFilter text="Documents" key="documents">
                <VBox class="detailTabContent">
                  <MessageStrip
                    text="Documents are visible in all the versions of the specification."
                    type="Warning"
                    showCloseButton="true"
                    class="sapUiSmallMarginBottom" />
                  <Link text="09a212e0-65fa-4464-907d-d52c1b844027" class="sapUiTinyMarginBottom" />
                  <Toolbar class="sapUiSizeCompact detailSectionToolbar">
                    <Button text="Standard" icon="sap-icon://slim-arrow-down" iconFirst="false" type="Transparent" class="detailDocStandardBtn" />
                    <Text text="Items (1)" class="sapUiSmallMarginBegin" />
                    <SearchField placeholder="Search" width="16rem" class="sapUiSmallMarginBegin" />
                    <Button icon="sap-icon://attachment" type="Transparent" />
                    <Button text="Create" type="Emphasized" iconFirst="false" icon="sap-icon://slim-arrow-down" />
                    <Button text="Edit Link" type="Transparent" enabled="false" />
                    <Button text="Download" type="Transparent" enabled="false" />
                    <Button text="Delete" type="Transparent" enabled="false" />
                    <Button text="Move" type="Transparent" enabled="false" />
                    <Button text="Copy" type="Transparent" enabled="false" />
                    <MenuButton text="Manage Document" type="Transparent" buttonMode="Regular" menuPosition="BeginBottom">
                      <menu>
                        <Menu>
                          <items>
                            <MenuItem text="Check In" />
                            <MenuItem text="Check Out" />
                          </items>
                        </Menu>
                      </menu>
                    </MenuButton>
                    <ToolbarSpacer />
                    <Button icon="sap-icon://collaborate" type="Transparent" />
                    <Button icon="sap-icon://refresh" type="Transparent" />
                    <Button icon="sap-icon://sort" type="Transparent" />
                    <Button icon="sap-icon://action-settings" type="Transparent" />
                  </Toolbar>
                  <Table items="{detail>/documents}" mode="MultiSelect" class="sapUiSizeCompact detailTable">
                    <columns>
                      <Column width="5rem"><Text text="Type" /></Column>
                      <Column><Text text="Name" /></Column>
                      <Column width="9rem"><Text text="Modified On" /></Column>
                      <Column><Text text="Created By" /></Column>
                      <Column><Text text="Modified By" /></Column>
                      <Column width="7rem"><Text text="Size" /></Column>
                      <Column width="3rem" />
                    </columns>
                    <items>
                      <ColumnListItem>
                        <cells>
                          <Avatar src="sap-icon://document" displayShape="Square" class="manageSpecAvatar" />
                          <Text text="{name}" class="detailDocName" />
                          <Text text="{modifiedOn}" />
                          <Text text="{createdBy}" />
                          <Text text="{modifiedBy}" />
                          <Text text="{size}" />
                          <Button icon="sap-icon://overflow" type="Transparent" />
                        </cells>
                      </ColumnListItem>
                    </items>
                    <noData>
                      <IllustratedMessage illustrationType="sapIllus-EmptyList" illustrationSize="Scene"
                        title="No documents" description="No documents have been attached yet." />
                    </noData>
                  </Table>
                </VBox>
              </IconTabFilter>

            </items>
          </IconTabBar>
        </f:content>

      </f:DynamicPage>
    </content>
  </Page>

</mvc:View>
