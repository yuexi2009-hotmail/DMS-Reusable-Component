<mvc:View
  controllerName="com.sap.demo.managespec.controller.Detail"
  displayBlock="true"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:uxap="sap.uxap"
  xmlns:layout="sap.ui.layout"
  xmlns:form="sap.ui.layout.form"
  xmlns:core="sap.ui.core">

  <Page showHeader="false" enableScrolling="false">
    <content>
      <uxap:ObjectPageLayout
        id="objectPageLayout"
        useIconTabBar="true"
        upperCaseAnchorBar="false"
        showAnchorBarPopover="false"
        showTitleInHeaderContent="false"
        alwaysShowContentHeader="false"
        preserveHeaderStateOnScroll="false"
        class="sapUiSizeCompact">

        <uxap:headerTitle>
          <uxap:ObjectPageDynamicHeaderTitle>

            <uxap:heading>
              <VBox>
                <Title text="{detail>/description}" level="H2"/>
                <Text text="{detail>/number}" class="detailDocNumber"/>
              </VBox>
            </uxap:heading>

            <uxap:snappedHeading>
              <VBox>
                <Title text="{detail>/description}" level="H3"/>
                <Text text="{detail>/number}" class="detailDocNumber"/>
              </VBox>
            </uxap:snappedHeading>

            <uxap:actions>
              <Button text="Edit"          type="Emphasized" press=".onEditPress"         enabled="{= ${detail>/documentStatus} !== 'Released'}"/>
              <Button text="Delete"        type="Ghost"      press=".onDeletePress"       enabled="{= ${detail>/documentStatus} !== 'Released'}"/>
              <Button text="Change Status" type="Ghost"      press=".onChangeStatusPress" enabled="{= ${detail>/documentStatus} !== 'Released'}"/>
              <Button text="New Version"   type="Ghost"      press=".onNewVersionPress"/>
              <Button text="Sync with S4"  type="Ghost"      press=".onSyncWithS4Press"/>
              <Button icon="sap-icon://action" type="Transparent" press=".onMoreActionsPress" tooltip="Share"/>
            </uxap:actions>

          </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:headerContent>
          <FlexBox wrap="NoWrap" alignItems="Center">
            <Label text="Status:" class="detailHeaderLabel sapUiTinyMarginEnd"/>
            <Label text="{detail>/documentStatus}" class="detailHeaderValue sapUiLargeMarginEnd"/>
            <Label text="Version:" class="detailHeaderLabel sapUiTinyMarginEnd"/>
            <Label text="{detail>/version}" class="detailHeaderValue sapUiLargeMarginEnd"/>
            <Label text="Sync Status:" class="detailHeaderLabel sapUiTinyMarginEnd"/>
            <ObjectStatus
              id="syncStatusDisplay"
              text="{detail>/s4SyncText}"
              state="{detail>/s4SyncState}"
              icon="{detail>/s4SyncIcon}"/>
          </FlexBox>
        </uxap:headerContent>

        <uxap:sections>

          <!-- General Tab -->
          <uxap:ObjectPageSection title="General" titleUppercase="false">
            <uxap:subSections>

              <uxap:ObjectPageSubSection title=" " wrapperEnabled="false">
                <uxap:blocks>
                  <form:SimpleForm
                    layout="ColumnLayout"
                    columnsM="2" columnsL="4" columnsXL="4"
                    class="sapUxAPObjectPageSubSectionAlignContent">
                    <Label text="IPD Number"/>
                    <Text text="{detail>/number}"/>
                    <Label text="S4 Number"/>
                    <Text text="{detail>/s4Number}"/>
                    <Label text="IPD Type"/>
                    <Text text="{detail>/type}"/>
                    <Label text="S4 Type"/>
                    <Text text="{detail>/s4Type}"/>
                    <Label text="Part"/>
                    <Text text="{detail>/part}"/>
                    <Label text="Description"/>
                    <Text text="{detail>/description}"/>
                    <Label text="Owner"/>
                    <Text text="{detail>/owner}"/>
                  </form:SimpleForm>
                </uxap:blocks>
              </uxap:ObjectPageSubSection>

              <uxap:ObjectPageSubSection title="Attachments" titleUppercase="false" wrapperEnabled="false">
                <uxap:blocks>
                  <Table
                    id="docAttachmentsTable"
                    items="{detail>/attachments}"
                    mode="MultiSelect"
                    selectionChange=".onAttachmentSelectionChange"
                    sticky="ColumnHeaders,HeaderToolbar"
                    growing="true"
                    growingThreshold="20"
                    width="100%"
                    class="sapUiSizeCompact">
                    <headerToolbar>
                      <OverflowToolbar>
                        <VariantManagement selectedKey="standard">
                          <VariantItem key="standard" text="Standard"/>
                        </VariantManagement>
                        <Text text="Items ({= ${detail>/attachments/length}})" class="sapMText sapUiSmallMarginBegin"/>
                        <ToolbarSpacer/>
                        <SearchField id="attSearchField" width="15rem" placeholder="Search" search=".onAttSearch"/>
                        <Button id="attUploadBtn"   icon="sap-icon://person-placeholder" type="Transparent" tooltip="Responsible" enabled="false"/>
                        <Button id="attEditLinkBtn" text="Edit Link"  type="Transparent" enabled="{= ${detail>/documentStatus} !== 'Released' &amp;&amp; ${detail>/attHasSelection}}" press=".onAttEditLink"/>
                        <Button id="attDownloadBtn" text="Download"   type="Transparent" enabled="{detail>/attHasSelection}" press=".onAttDownload"/>
                        <Button id="attDeleteBtn"   text="Delete"     type="Transparent" enabled="{= ${detail>/documentStatus} !== 'Released' &amp;&amp; ${detail>/attHasSelection}}" press=".onAttDelete"/>
                        <MenuButton id="attManageBtn" text="Manage Document" type="Transparent" buttonMode="Regular" menuPosition="BeginBottom" enabled="{= ${detail>/documentStatus} !== 'Released' &amp;&amp; ${detail>/attHasSelection}}">
                          <menu>
                            <Menu>
                              <items>
                                <MenuItem text="Check Out"  press=".onAttCheckOut"/>
                                <MenuItem text="Check In"   press=".onAttCheckIn"/>
                                <MenuItem text="Properties" press=".onAttProperties"/>
                              </items>
                            </Menu>
                          </menu>
                        </MenuButton>
                        <Button icon="sap-icon://delete"          type="Transparent" tooltip="Delete"   enabled="false"/>
                        <Button icon="sap-icon://refresh"         type="Transparent" tooltip="Refresh"  press=".onAttRefresh"/>
                        <Button icon="sap-icon://sort"            type="Transparent" tooltip="Sort"/>
                        <Button icon="sap-icon://action-settings" type="Transparent" tooltip="Settings"/>
                      </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                      <Column width="3.5rem" hAlign="Center"><Text text="Type"/></Column>
                      <Column><Text text="Name"/></Column>
                      <Column width="10rem"><Text text="Modified On"/></Column>
                      <Column width="14rem"><Text text="Created By"/></Column>
                      <Column width="14rem"><Text text="Modified By"/></Column>
                      <Column width="6rem"><Text text="Size"/></Column>
                      <Column width="4rem"><Text text=""/></Column>
                    </columns>
                    <items>
                      <ColumnListItem>
                        <cells>
                          <core:Icon src="{detail>typeIcon}" class="docAttTypeIcon"/>
                          <Text text="{detail>name}" wrapping="false" class="docAttNameBold"/>
                          <Text text="{detail>modifiedOn}" wrapping="false"/>
                          <Text text="{detail>createdBy}" wrapping="false"/>
                          <Text text="{detail>modifiedBy}" wrapping="false"/>
                          <Text text="{detail>size}" wrapping="false"/>
                          <Button icon="sap-icon://overflow" type="Transparent" press=".onAttRowMore" tooltip="More"/>
                        </cells>
                      </ColumnListItem>
                    </items>
                  </Table>
                </uxap:blocks>
              </uxap:ObjectPageSubSection>

            </uxap:subSections>
          </uxap:ObjectPageSection>

          <!-- Attachments Tab -->
          <uxap:ObjectPageSection title="Attachments" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection title=" ">
                <uxap:blocks><VBox class="sapUiSmallMargin"><Text text="No data"/></VBox></uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>

          <!-- Linked Objects Tab -->
          <uxap:ObjectPageSection title="Linked Objects" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection title=" ">
                <uxap:blocks><VBox class="sapUiSmallMargin"><Text text="No data"/></VBox></uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>

          <!-- Change Processes Tab -->
          <uxap:ObjectPageSection title="Change Processes" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection title=" ">
                <uxap:blocks><VBox class="sapUiSmallMargin"><Text text="No data"/></VBox></uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>

          <!-- Translation Tab -->
          <uxap:ObjectPageSection title="Translation" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection title=" ">
                <uxap:blocks><VBox class="sapUiSmallMargin"><Text text="No data"/></VBox></uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>

          <!-- External Links Tab -->
          <uxap:ObjectPageSection title="External Links" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection title=" " wrapperEnabled="false">
                <uxap:blocks>
                  <Table
                    id="externalLinksTable"
                    items="{detail>/externalLinks}"
                    mode="MultiSelect"
                    sticky="ColumnHeaders,HeaderToolbar"
                    growing="true"
                    growingThreshold="20"
                    width="100%"
                    class="sapUiSizeCompact">
                    <headerToolbar>
                      <OverflowToolbar>
                        <Title text="External Links" level="H4" class="sapUiTinyMarginEnd"/>
                        <Text text="({= ${detail>/externalLinks} ? ${detail>/externalLinks/length} : 0})" class="sapMText"/>
                        <ToolbarSpacer/>
                        <Button text="Add" icon="sap-icon://add" type="Transparent" press=".onExtLinkAdd"/>
                        <Button id="extLinkDeleteBtn" text="Delete" icon="sap-icon://delete" type="Transparent" enabled="false" press=".onExtLinkDelete"/>
                        <Button icon="sap-icon://refresh" type="Transparent" tooltip="Refresh" press=".onExtLinkRefresh"/>
                      </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                      <Column><Text text="Name"/></Column>
                      <Column><Text text="Description"/></Column>
                      <Column width="10rem" hAlign="End"><Text text="Created On"/></Column>
                      <Column width="14rem" hAlign="Begin"><Text text="Created By"/></Column>
                      <Column width="10rem" hAlign="End"><Text text="Changed On"/></Column>
                      <Column width="3rem"><Text text=""/></Column>
                    </columns>
                    <items>
                      <ColumnListItem>
                        <cells>
                          <Text text="{detail>name}" wrapping="false"/>
                          <Text text="{detail>description}" wrapping="false"/>
                          <Text text="{detail>createdOn}" wrapping="false"/>
                          <Text text="{detail>createdBy}" wrapping="false"/>
                          <Text text="{detail>changedOn}" wrapping="false"/>
                          <Button icon="sap-icon://overflow" type="Transparent" tooltip="More"/>
                        </cells>
                      </ColumnListItem>
                    </items>
                  </Table>
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>

          <!-- History Tab -->
          <uxap:ObjectPageSection title="History" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection title=" ">
                <uxap:blocks><VBox class="sapUiSmallMargin"><Text text="No data"/></VBox></uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>

          <!-- Administration Tab -->
          <uxap:ObjectPageSection title="Administration" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection title=" ">
                <uxap:blocks><VBox class="sapUiSmallMargin"><Text text="No data"/></VBox></uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>

        </uxap:sections>
      </uxap:ObjectPageLayout>
    </content>
  </Page>

</mvc:View>
